# Set this to the public production origin. It is used for canonical URLs,
# Open Graph metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://example.com

# Required for generating custom bánh mì illustrations from the builder.
HUGGING_FACE_API_KEY=
HUGGING_FACE_IMAGE_PROVIDER=fal-ai
HUGGING_FACE_IMAGE_MODEL=ideogram-ai/ideogram-4-fp8

# Required on Vercel for persistent generated image caching.
# Use a public Vercel Blob store so cached image URLs can be rendered directly.
BLOB_READ_WRITE_TOKEN=
